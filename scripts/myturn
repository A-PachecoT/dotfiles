#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""myturn — tus tareas y los agentes que trabajan en ellas, en la barra. SSOT: ~/dotfiles/docs/myturn.md

La UI es el panel del widget (clic en la barra o ⌥T). Este CLI es lo que el panel y los agentes llaman:

  myturn                          ⌥G: salta al siguiente agente que te espera (= myturn jump)
  myturn add "título" [--prio 1|2] [--raw]   nueva tarea (--raw: la IA saca fecha y prioridad)
  myturn edit ID "nuevo título"   renombrar
  myturn prio 0|1|2 [--id ID]     prioridad (0 = sin prioridad); sin --id: tu propia sesión si eres un agente
  myturn done|archive|restore ID  cerrar / podar / deshacer
  myturn link ID                  (lo corre un agente) enlaza ESTA sesión de Claude a la tarea ID
  myturn go ID                    ir al agente de la tarea (o reabrirlo si se cerró)
  myturn ls [--json]              tus tareas, las que te esperan primero
  myturn panel                    JSON para el panel de Hammerspoon
  myturn obsidian                 (timer del Arch) espejo Tareas.md + importar lo anotado en el daily note
  myturn import | garden [--ai] | track | sketchybar     mantenimiento, poda, hook y barra

Store: $MYTURN_HOME (default ~/tasks): events.jsonl append-only (merge=union), sincronizado por git.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import platform
import re
import secrets
import shutil
import subprocess
import sys
import time
from datetime import date, datetime, timedelta
from pathlib import Path

HOME = Path.home()
DATA = Path(os.environ.get("MYTURN_HOME", HOME / "tasks"))
EVENTS = DATA / "events.jsonl"
STATE = DATA / "state.json"
CACHE = Path(os.environ.get("MYTURN_CACHE", HOME / ".cache/myturn"))
LOCAL = "mac" if platform.system() == "Darwin" else "arch"
REMOTE_SSH = {"arch": "andre-arch", "mac": "styreep@100.73.150.52"}
HERDR_WINDOW = {"mac": "herdr-mac", "arch": "herdr-arch"}
NO_SYNC = os.environ.get("MYTURN_NO_SYNC") == "1"
SELF = str(Path(__file__).resolve())
WAITING = {"idle", "blocked", "done"}
STALE_DAYS = 14          # tarea sin agente y sin tocar
DEAD_AGENT_H = 12        # sesión registrada por el hook, que no es tuya, inactiva
SOUND = "/System/Library/Sounds/Glass.aiff"
VAULT = Path(os.environ.get("MYTURN_VAULT", HOME / "BrainFlow"))
TAREAS = VAULT / "05. System" / "myturn" / "Tareas.md"
GATE = Path(os.environ.get("MYTURN_GATE", HOME / ".local/bin/vault-write-gate.py"))

# sketchybar, Hammerspoon y los hooks arrancan con PATH mínimo
os.environ["PATH"] = os.pathsep.join(
    [str(HOME / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "/usr/bin:/bin")])
os.environ.setdefault("USER", HOME.name)


# ── store ─────────────────────────────────────────────────────────────────────────────────────────
def now() -> datetime:
    return datetime.now().astimezone()


def iso(d: datetime) -> str:
    return d.isoformat(timespec="seconds")


def parse(ts: str | None) -> datetime | None:
    return datetime.fromisoformat(ts) if ts else None


def emit(op: str, id: str, **data) -> dict:
    ev = {"ts": iso(now()), "host": LOCAL, "op": op, "id": id, **{k: v for k, v in data.items() if v is not None}}
    DATA.mkdir(parents=True, exist_ok=True)
    with open(EVENTS, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(ev, ensure_ascii=False) + "\n")
    return ev


def fold() -> dict[str, dict]:
    tasks: dict[str, dict] = {}
    if not EVENTS.exists():
        return tasks
    lines = [json.loads(ln) for ln in EVENTS.read_text().splitlines() if ln.strip()]
    for ev in sorted(lines, key=lambda e: e["ts"]):  # merge=union puede intercalar líneas de dos cajas
        op, tid, ts = ev["op"], ev["id"], ev["ts"]
        if op == "add":
            tasks[tid] = {"id": tid, "title": ev.get("title", ""), "raw": ev.get("raw"), "prio": ev.get("prio"),
                          "due": ev.get("due"), "cwd": ev.get("cwd"), "status": "open", "created": ts,
                          "touched": ts, "link": ev.get("link"), "source": ev.get("source", "capture"),
                          "reason": None, "by": ev.get("by"), "title_fixed": False}
            continue
        t = tasks.get(tid)
        if not t:
            continue
        t["touched"] = ts
        if op == "update":
            t.update(ev.get("set", {}))
            if "title" in ev.get("set", {}):
                t["title_fixed"] = True
        elif op == "done":
            t.update(status="done", done_at=ts)
        elif op == "archive":
            t.update(status="archived", archived_at=ts, reason=ev.get("reason"), by=ev.get("by"))
        elif op == "restore":
            t.update(status="open", reason=None)
        elif op == "link":
            t["link"] = ev.get("link")
    return tasks


def mine(t: dict) -> bool:
    """Tus tareas: las que escribiste tú (o un agente por ti) y las sesiones a las que les pusiste prioridad.
    Las sesiones que el hook registra solo existen para poder enlazarlas; no se muestran."""
    return t["status"] == "open" and (t.get("source") != "agent" or bool(t.get("prio")))


def by_session(tasks: dict) -> dict[str, dict]:
    """Sesión → tarea abierta enlazada; si hay varias, gana la tuya sobre la registrada por el hook."""
    out: dict[str, dict] = {}
    for t in tasks.values():
        s = (t.get("link") or {}).get("session")
        if s and t["status"] == "open" and (s not in out or mine(t)):
            out[s] = t
    return out


def new_id() -> str:
    return "t" + secrets.token_hex(3)


def find(tasks: dict, ref: str) -> dict:
    hits = [t for t in tasks.values() if t["id"].startswith(ref.lstrip("#"))]
    if len(hits) != 1:
        sys.exit(f"myturn: no encuentro una única tarea '{ref}'")
    return hits[0]


# ── sync (git, en segundo plano) ──────────────────────────────────────────────────────────────────
def spawn(*args: str) -> None:
    subprocess.Popen([sys.executable, SELF, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def sync_bg() -> None:
    if not NO_SYNC and (DATA / ".git").exists():
        spawn("_sync")


def do_sync() -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(CACHE / "sync.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        def g(*a: str) -> None:
            subprocess.run(["git", "-C", str(DATA), *a], capture_output=True, text=True, timeout=30)
        g("add", "events.jsonl")
        g("commit", "-qm", f"myturn: {LOCAL} {iso(now())}")
        g("pull", "-q", "--rebase")
        g("push", "-q")


def every(name: str, seconds: float) -> bool:
    """True como mucho una vez cada `seconds` (marca en el caché)."""
    f = CACHE / f"last_{name}"
    try:
        if time.time() - float(f.read_text()) < seconds:
            return False
    except (OSError, ValueError):
        pass
    CACHE.mkdir(parents=True, exist_ok=True)
    f.write_text(str(time.time()))
    return True


# ── herdr / sistema ───────────────────────────────────────────────────────────────────────────────
def sh_quote(s: str) -> str:
    return "'" + s.replace("'", "'\\''") + "'"


def run(cmd: list[str], host: str = LOCAL, timeout: float = 4) -> subprocess.CompletedProcess | None:
    if host != LOCAL:
        cmd = ["ssh", "-o", "ConnectTimeout=3", "-o", "BatchMode=yes", REMOTE_SSH[host], " ".join(map(sh_quote, cmd))]
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def herdr_json(args: list[str], host: str = LOCAL, timeout: float = 4) -> dict | None:
    p = run(["herdr", *args], host, timeout)
    if not p or p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout)["result"]
    except (ValueError, KeyError):
        return None


def herdr_agents(host: str, fresh: bool = False) -> list[dict] | None:
    """Agentes de Claude en herdr de esa caja; None si no se pudo leer.

    Lo remoto (ssh, hasta 6 s si la red tarda) sale del caché y, si pasó de 60 s, se renueva en segundo plano: un
    clic en el panel nunca espera a la red. Un caché de más de 10 min no se cree (la otra caja no responde).
    `fresh` lo lee en el acto: `go` no debe reabrir un agente que solo le falta al caché."""
    cache = CACHE / f"agents-{host}.json"
    if host != LOCAL and not fresh:
        try:
            age, agents = time.time() - cache.stat().st_mtime, json.loads(cache.read_text())
        except (OSError, ValueError):
            age, agents = None, None
        if age is not None:
            if age > 60 and every(f"agents-{host}", 20):
                spawn("_agents", host)
            return agents if age < 600 else None
    res = herdr_json(["agent", "list"], host, timeout=4 if host == LOCAL else 6)
    if res is None:
        return None
    agents = [a for a in res.get("agents", []) if a.get("agent") == "claude"]
    if host != LOCAL:
        write_atomic(cache, json.dumps(agents))
    return agents


def session_of(a: dict) -> str | None:
    return (a.get("agent_session") or {}).get("value")


GLYPH = re.compile(r"^[^\w¿¡\"'(\[]+\s*")


def clean_title(s: str | None) -> str:
    """Claude Code pone su estado como primer glifo (✳ idle, ◐ trabajando…); herdr no lo quita."""
    t = GLYPH.sub("", (s or "").strip()).strip()
    return "" if t.lower() in {"claude", "claude code", HOME.name} else t


def herdr_frontmost() -> str | None:
    """'mac'/'arch' si la ventana enfocada es la de herdr de esa caja."""
    if LOCAL != "mac" or not shutil.which("aerospace"):
        return None
    p = run(["aerospace", "list-windows", "--focused", "--format", "%{window-title}"], timeout=2)
    title = (p.stdout.strip() if p else "")
    return next((h for h, w in HERDR_WINDOW.items() if title == w), None)


def focus_window(host: str) -> None:
    if LOCAL != "mac" or not shutil.which("aerospace"):
        return
    p = run(["aerospace", "list-windows", "--all", "--format", "%{window-id}|%{window-title}"])
    for line in (p.stdout if p else "").splitlines():
        wid, _, title = line.partition("|")
        if title.strip() == HERDR_WINDOW[host]:
            run(["aerospace", "focus", "--window-id", wid.strip()])
            return


def notify(msg: str, sound: bool = False) -> None:
    if LOCAL != "mac":
        return
    if sound and Path(SOUND).exists():
        subprocess.Popen(["afplay", SOUND], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run(["osascript", "-e", f"display notification {json.dumps(msg)} with title \"myturn\""])


# ── estado: en qué está cada tarea ────────────────────────────────────────────────────────────────
def load_seen() -> dict:
    try:
        return json.loads((CACHE / "seen.json").read_text())
    except (OSError, ValueError):
        return {}


def save_seen(seen: dict) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "seen.json").write_text(json.dumps(seen))


def mark_seen(session: str) -> None:
    seen = load_seen()
    if session in seen:
        seen[session]["seen_at"] = iso(now())
        save_seen(seen)


def ago(ts: str) -> str:
    m = max(0, int((now() - parse(ts)).total_seconds() // 60))
    return f"{m} min" if m < 60 else f"{m // 60} h" if m < 1440 else f"{m // 1440} d"


def observe(lists: dict[str, list | None], front: str | None, t0: datetime) -> dict[str, dict]:
    """Registra transiciones y «visto» de cada sesión. {session: info}"""
    seen = load_seen()
    info: dict[str, dict] = {}
    for host, agents in lists.items():
        for a in agents or []:
            s = session_of(a)
            if not s:
                continue
            st = a.get("agent_status", "unknown")
            rec = seen.get(s)
            if not rec or rec.get("status") != st:
                rec = {"status": st, "since": iso(t0), "seen_at": None, "notified": False}
            if st in WAITING and a.get("focused") and front == host and not rec.get("seen_at"):
                rec["seen_at"] = iso(t0)
            seen[s] = rec
            info[s] = rec | {"pane": a.get("pane_id"), "host": host, "title": clean_title(a.get("terminal_title"))}
    save_seen(seen)
    return info


# estado de la fila → (punto, texto); el orden de este dict es el orden de la lista
STATES = {"waiting": "●", "working": "◌", "seen": "○", "closed": "○", "none": "○"}


def classify(tasks: dict, info: dict[str, dict], lists: dict[str, list | None]) -> dict:
    t0, today = now(), date.today()
    rows, background = [], 0
    for t in tasks.values():
        link = t.get("link")
        if not mine(t):
            background += bool(link and t["status"] == "open")
            continue
        row = {k: t.get(k) for k in ("id", "title", "prio", "due", "created", "link", "source")}
        ag = info.get(link["session"]) if link else None
        if ag and t.get("source") == "agent" and not t.get("title_fixed") and ag["title"]:
            row["title"] = ag["title"]
        since = ag["since"] if ag else t["created"]
        if not link:
            state, say = "none", "sin agente · cópiala a un Claude"
        elif not ag:
            known = lists.get(link["host"]) is not None
            state, say = ("closed", "agente cerrado") if known else ("closed", "no veo su caja")
        elif ag["status"] == "working":
            state, say = "working", "trabajando…"
        elif ag["status"] in WAITING and not ag.get("seen_at"):
            state = "waiting"
            say = "te hizo una pregunta" if ag["status"] == "blocked" else f"terminó hace {ago(ag['since'])}"
        else:
            state, say = "seen", "ya lo viste"
        due = date.fromisoformat(t["due"]) if t.get("due") else None
        if due:
            d = (due - today).days
            say += " · " + ("vence hoy" if d == 0 else f"vencida hace {-d} d" if d < 0 else
                            "vence mañana" if d == 1 else f"vence el {due.strftime('%d/%m')}")
        row |= {"state": state, "dot": STATES[state], "say": say, "since": since,
                "can_go": bool(ag), "can_resume": bool(link and not ag)}
        rows.append(row)
    order = list(STATES)
    rows.sort(key=lambda r: (order.index(r["state"]) if r["state"] == "waiting" else 1, r["prio"] or 9,
                             r["due"] or "9999", r["since"] if r["state"] == "waiting" else r["created"]))
    tracked = set(by_session(tasks))
    untracked = sum(1 for agents in lists.values() for a in agents or [] if session_of(a) not in tracked)
    by = {s: [r for r in rows if r["state"] == s] for s in STATES}
    return {"updated": iso(t0), "rows": rows, "waiting": by["waiting"], "working": by["working"],
            "seen": by["seen"], "background": background, "untracked": untracked,
            "herdr_ok": lists.get(LOCAL) is not None}


def compute(notify_new: bool = False) -> dict:
    tasks = fold()
    hosts = {LOCAL} | {t["link"]["host"] for t in tasks.values() if mine(t) and t.get("link")}
    lists = {h: herdr_agents(h) for h in hosts}
    info = observe(lists, herdr_frontmost(), now())
    state = classify(tasks, info, lists)
    if notify_new:
        seen, fresh = load_seen(), []
        for r in state["waiting"]:
            s = r["link"]["session"]
            if not seen.get(s, {}).get("notified"):
                seen.setdefault(s, {})["notified"] = True
                fresh.append(r)
        if fresh:
            save_seen(seen)
            notify(f"Te espera: {fresh[0]['title']}" + (f" (+{len(fresh) - 1})" if len(fresh) > 1 else ""),
                   sound=True)
    STATE.write_text(json.dumps(state, ensure_ascii=False, indent=1, default=str))
    return state


# ── acciones ──────────────────────────────────────────────────────────────────────────────────────
def go(t: dict) -> str:
    link = t.get("link")
    if not link:
        return "Esta tarea no tiene agente: cópiala y pégasela a un Claude"
    agents = herdr_agents(link["host"], fresh=True) or []
    ag = next((a for a in agents if session_of(a) == link["session"]), None)
    if ag:
        focus_window(link["host"])
        run(["herdr", "agent", "focus", ag["pane_id"]], link["host"])
        mark_seen(link["session"])
        return f"→ {t['title']}"
    res = herdr_json(["tab", "create", "--cwd", t.get("cwd") or str(HOME), "--label", t["title"][:24], "--focus"],
                     link["host"], timeout=8)
    pane = ((res or {}).get("root_pane") or {}).get("pane_id")
    if not pane:
        return f"No pude abrir una pestaña en herdr ({link['host']})"
    run(["herdr", "pane", "run", pane, f"claude --resume {link['session']}"], link["host"], timeout=8)
    focus_window(link["host"])
    return f"↻ Reabriendo el agente de {t['title']}"


def jump() -> str:
    st = compute()
    if not st["waiting"]:
        return "nadie te espera"
    msg = go(fold()[st["waiting"][0]["id"]])
    refresh()
    return msg


def here() -> dict | None:
    """El pane de herdr de ESTE proceso (cuando lo corre un agente)."""
    if not os.environ.get("HERDR_PANE_ID"):
        return None
    cur = (herdr_json(["pane", "current"]) or {}).get("pane")
    return cur if cur and session_of(cur) else None


def link_here(tid: str) -> str:
    """Un agente se enlaza a una tarea: desde ahora su estado es el de la tarea."""
    tasks, cur = fold(), here()
    if not cur:
        sys.exit("myturn: link solo funciona dentro de un pane de herdr con Claude")
    t, s = find(tasks, tid), session_of(cur)
    emit("link", t["id"], link={"host": LOCAL, "session": s, "pane": cur.get("pane_id")})
    for other in tasks.values():  # la sesión que el hook registró queda fusionada en la tarea
        if other["id"] != t["id"] and other["status"] == "open" and other.get("source") == "agent" \
                and (other.get("link") or {}).get("session") == s:
            emit("archive", other["id"], reason=f"fusionada con {t['id']}", by="link")
    sync_bg()
    refresh()
    return f"Enlazado: esta sesión trabaja en «{t['title']}» ({t['id']}). André verá cuándo terminas."


def target(ref: str | None) -> dict:
    if ref:
        return find(fold(), ref)
    cur = here()
    if not cur:
        sys.exit("myturn: dime la tarea con --id")
    t = by_session(fold()).get(session_of(cur))
    if t:
        return t
    tid = new_id()
    emit("add", tid, title=clean_title(cur.get("terminal_title")) or "agente", source="agent", cwd=cur.get("cwd"),
         link={"host": LOCAL, "session": session_of(cur), "pane": cur.get("pane_id")})
    return fold()[tid]


def track(payload: dict) -> None:
    """Hook UserPromptSubmit: registra la sesión la primera vez, para poder enlazarla. Silencioso."""
    sid, pane = payload.get("session_id"), os.environ.get("HERDR_PANE_ID")
    if not sid or not pane:
        return
    if sid in by_session(fold()):
        return
    cur = herdr_json(["pane", "current"], timeout=2) or {}
    if session_of(cur.get("pane") or {}) != sid:  # p. ej. un `claude -p` que corre dentro de un pane
        return
    prompt = (payload.get("prompt") or "").strip().splitlines()
    title = clean_title((cur.get("pane") or {}).get("terminal_title")) or (prompt[0][:70] if prompt else "agente")
    emit("add", new_id(), title=title, source="agent", cwd=payload.get("cwd"),
         link={"host": LOCAL, "session": sid, "pane": pane})
    sync_bg()


def import_sessions() -> int:
    tracked, n = set(by_session(fold())), 0
    for a in herdr_agents(LOCAL) or []:
        s = session_of(a)
        if s and s not in tracked:
            emit("add", new_id(), title=clean_title(a.get("terminal_title")) or Path(a.get("cwd", "~")).name,
                 source="agent", cwd=a.get("cwd"), by="import",
                 link={"host": LOCAL, "session": s, "pane": a.get("pane_id")})
            n += 1
    if n:
        sync_bg()
    return n


def claude_prompt(t: dict) -> str:
    """Lo que el botón «Copiar para Claude» pone en el portapapeles."""
    return (f"Ayúdame con esta tarea: «{t['title']}». Antes de empezar, corre `myturn link {t['id']}` para "
            "enlazar esta sesión a la tarea (así André ve en su barra cuándo terminas).")


# ── IA (opcional, solo para capturas con --raw) ───────────────────────────────────────────────────
def claude_json(prompt: str, schema: dict, model: str = "haiku", timeout: int = 120) -> dict | None:
    exe = shutil.which("claude")
    if not exe:
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    try:
        p = subprocess.run([exe, "-p", prompt, "--model", model, "--no-session-persistence", "--setting-sources", "",
                            "--disable-slash-commands", "--output-format", "json", "--json-schema", json.dumps(schema)],
                           capture_output=True, text=True, timeout=timeout, cwd=str(CACHE))
        return json.loads(p.stdout).get("structured_output")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def today_line() -> str:
    t = now()
    dias = ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"]
    return f"Hoy es {dias[t.weekday()]} {t.date().isoformat()}, {t.strftime('%H:%M')} (hora de Lima)."


def enrich(tid: str) -> None:
    t = fold().get(tid)
    if not t or not t.get("raw"):
        return
    schema = {"type": "object", "required": ["title", "prio", "due"], "properties": {
        "title": {"type": "string", "description": "imperativo, corto (≤60 chars), en el idioma del texto"},
        "prio": {"type": ["integer", "null"], "enum": [1, 2, None],
                 "description": "1 solo si dice urgente/hoy/prioritario; 2 si dice importante; null si no hay señal"},
        "due": {"type": ["string", "null"], "description": "YYYY-MM-DD solo si el texto da un plazo; si no, null"}}}
    out = claude_json(f"{today_line()}\nConvierte esta captura en una tarea. No inventes plazos ni prioridad "
                      f"que el texto no diga.\n\nCaptura: {t['raw']}", schema)
    if out:
        emit("update", tid, set={k: out[k] for k in ("title", "prio", "due") if out.get(k)}, by="ai")
        sync_bg()
    refresh()


def garden(use_ai: bool) -> list[dict]:
    tasks, t0, acts = fold(), now(), []
    agents = herdr_agents(LOCAL)
    live = {session_of(a): a for a in agents or []}
    seen = load_seen()

    def archive(t: dict, reason: str) -> None:
        emit("archive", t["id"], reason=reason, by="garden")
        acts.append({"id": t["id"], "title": t["title"], "archive": reason})

    for t in tasks.values():
        if t["status"] != "open":
            continue
        link = t.get("link")
        if link and t.get("source") == "agent" and not mine(t) and link["host"] == LOCAL and agents is not None:
            a = live.get(link["session"])
            since = parse(seen.get(link["session"], {}).get("since"))
            if not a:
                archive(t, "sesión cerrada")
            elif a.get("agent_status") in WAITING and since and t0 - since > timedelta(hours=DEAD_AGENT_H):
                archive(t, f"sesión inactiva hace {ago(iso(since))}")
        elif not link and t.get("prio") != 1:
            idle = (t0 - parse(t["touched"])).days
            live_due = t.get("due") and (date.fromisoformat(t["due"]) - date.today()).days > -STALE_DAYS
            if idle >= STALE_DAYS and not live_due:
                archive(t, f"sin tocar hace {idle} d")
    loose = [t for t in fold().values() if t["status"] == "open" and not t.get("link")]
    if use_ai and loose:
        schema = {"type": "object", "required": ["archive"], "properties": {"archive": {"type": "array", "items": {
            "type": "object", "required": ["id", "reason"],
            "properties": {"id": {"type": "string"}, "reason": {"type": "string"}}}}}}
        rows = [{"id": t["id"], "title": t["title"], "prio": t.get("prio"), "due": t.get("due"),
                 "tocada_hace_d": (t0 - parse(t["touched"])).days} for t in loose]
        out = claude_json(f"{today_line()}\nEres el jardinero de las tareas de André. Propón archivar solo lo "
                          "claramente muerto o duplicado (es reversible). Sé conservador; razones de ≤8 palabras.\n\n"
                          + json.dumps(rows, ensure_ascii=False), schema, model="sonnet", timeout=240)
        ids = {t["id"]: t for t in loose}
        for a in (out or {}).get("archive", []):
            if a["id"] in ids:
                archive(ids[a["id"]], a["reason"])
    if acts:
        sync_bg()
    return acts


# ── Obsidian: Tareas.md es el espejo vivo; el daily note, un lugar más donde anotar ──────────────
# Un solo escritor (el timer del Arch, `myturn obsidian`). Ida y vuelta:
#   Tareas.md   ← myturn la reescribe; tú puedes marcar [x], editar el texto o agregar `- [ ] …` sin ^id
#   daily note  → cada `- [ ] …` tuyo del ### To-do (no 📅, no placeholder) entra a myturn y queda `- [>] … → myturn`
PRIO_EMOJI = {1: "⏫", 2: "🔼"}
TASK_LINE = re.compile(r"^(?P<ind>\s*)- \[(?P<box>.)\] (?P<desc>.*?)\s*$")
BLOCK_ID = re.compile(r"\s*\^(t[0-9a-f]{6})\s*$")
DUE_EMOJI = re.compile(r"\s*📅\s*(\d{4}-\d{2}-\d{2})")
DUE_FIELD = re.compile(r"\s*\[due::\s*(\d{4}-\d{2}-\d{2})\s*\]")
AGENT_FIELD = re.compile(r"\s*\[agente::[^\]]*\]")
MEETING = re.compile(r"^-\s+(?P<title>.+?)\.\s*Accionables:\s*$")
FORWARDED = "→ myturn"
AGENT_WORD = {"waiting": "te espera", "working": "trabajando", "seen": "ya lo viste", "closed": "agente cerrado"}
TAREAS_HEAD = ("# Tareas\n\n> Espejo vivo de myturn: se reescribe solo. Puedes marcar `[x]`, editar el texto, cambiar\n"
               "> ⏫ / 🔼 o agregar `- [ ] …` al final. No borres los `^t…` del final de cada línea.\n\n")


def gate_quiet(path: Path) -> bool:
    """El vault-write-gate de Hermes: 2 = André está escribiendo ese archivo ahora mismo."""
    if not GATE.exists():
        return True
    p = subprocess.run([sys.executable, str(GATE), str(path)], capture_output=True)
    return p.returncode != 2


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.myturn-tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def parse_desc(desc: str) -> tuple[str, int | None, str | None]:
    prio = 1 if "⏫" in desc else 2 if "🔼" in desc else None
    m = DUE_EMOJI.search(desc) or DUE_FIELD.search(desc)
    title = DUE_FIELD.sub("", DUE_EMOJI.sub("", AGENT_FIELD.sub("", desc)))
    title = re.sub(r"\s+", " ", title.replace("⏫", "").replace("🔼", "")).strip()
    return title, prio, (m.group(1) if m else None)


def tareas_line(r: dict) -> str:
    parts = [r["title"]]
    if r.get("prio"):
        parts.append(PRIO_EMOJI[r["prio"]])
    if r.get("due"):
        parts.append(f"📅 {r['due']}")
    if r.get("link") and r["state"] in AGENT_WORD:
        parts.append(f"[agente:: {AGENT_WORD[r['state']]}]")
    return f"- [ ] {' '.join(parts)} ^{r['id']}"


def read_tareas(tasks: dict, last: dict[str, str]) -> int:
    """Aplica lo que André cambió en Tareas.md desde la última escritura. Devuelve cuántos cambios."""
    if not TAREAS.exists():
        return 0
    n = 0
    for line in TAREAS.read_text().splitlines():
        m = TASK_LINE.match(line)
        if not m or m["ind"]:
            continue
        bid = BLOCK_ID.search(m["desc"])
        desc = BLOCK_ID.sub("", m["desc"])
        if not bid:
            if m["box"] == " " and desc.strip():
                title, prio, due = parse_desc(desc)
                emit("add", new_id(), title=title, prio=prio, due=due, source="obsidian")
                n += 1
            continue
        tid = bid.group(1)
        t = tasks.get(tid)
        if not t or t["status"] != "open" or last.get(tid) == line:
            continue  # sin cambios tuyos (o ya cerrada): manda myturn
        if m["box"].lower() == "x":
            emit("done", tid, by="obsidian")
            n += 1
            continue
        title, prio, due = parse_desc(desc)
        changed = {k: v for k, v in (("title", title), ("prio", prio), ("due", due)) if v != t.get(k)}
        if changed.get("title") == "":
            changed.pop("title")
        if changed:
            emit("update", tid, set=changed, by="obsidian")
            n += 1
    return n


def render_tareas(rows: list[dict]) -> tuple[str, dict[str, str]]:
    lines = [tareas_line(r) for r in rows]
    text = TAREAS_HEAD + "\n".join(lines) + ("\n" if lines else "")
    return text, {r["id"]: ln for r, ln in zip(rows, lines, strict=True)}


def import_daily(path: Path) -> list[str]:
    """Lo que escribiste como tarea en el ### To-do del daily note pasa a myturn; la línea queda `[>] … → myturn`.
    Primero escribe la nota y solo si eso funcionó emite los eventos: nunca importa dos veces."""
    if not path.exists() or not gate_quiet(path):
        return []
    content = path.read_text()
    m = re.search(r"### To-do\n(.*?)(?=\n## |\Z)", content, re.DOTALL)
    if not m:
        return []
    lines, adds, fence, changed = m.group(1).split("\n"), [], False, False
    # daily_prep copia cada pendiente al día siguiente: la misma línea vive en varias notas; se importa una vez
    known = {norm_title(t["title"]) for t in fold().values() if t["status"] == "open"}
    for i, line in enumerate(lines):
        if line.strip().startswith("```"):
            fence = not fence
            continue
        t = TASK_LINE.match(line)
        if fence or not t or t["box"] != " ":
            continue
        desc = t["desc"]
        if "📅" in desc or "GOAL FOR TODAY" in desc or "<%" in desc or desc.strip(" —-") == "" \
                or desc.endswith(FORWARDED):
            continue
        parent = ""
        if t["ind"]:
            for prev in reversed(lines[:i]):
                pm = TASK_LINE.match(prev)
                ind = len(prev) - len(prev.lstrip())
                if prev.strip() and ind < len(t["ind"]):
                    mm = MEETING.match(prev.strip())
                    parent = mm["title"] if mm else parse_desc(pm["desc"].replace(FORWARDED, ""))[0] if pm else ""
                    break
        title, prio, due = parse_desc(desc)
        full = f"{parent}: {title}" if parent else title
        if norm_title(full) not in known:
            adds.append({"title": full, "prio": prio, "due": due})
            known.add(norm_title(full))
        lines[i] = f"{t['ind']}- [>] {desc} {FORWARDED}"
        changed = True
    if not changed:
        return []
    body = "\n".join(lines)
    write_atomic(path, content[:m.start(1)] + body + content[m.end(1):])
    for a in adds:
        emit("add", new_id(), source="obsidian", by="daily", **a)
    return [a["title"] for a in adds]


def norm_title(s: str) -> str:
    return re.sub(r"\W+", " ", s.lower()).strip()


def daily_path(d: date) -> Path:
    return VAULT / "Calendar" / f"{d:%Y}" / f"{d:%m}" / f"{d:%Y-%m-%d}.md"


def obsidian_sync() -> dict:
    """Una pasada del timer del Arch. Idempotente; si André está escribiendo un archivo, lo deja para la próxima."""
    if not VAULT.exists():
        sys.exit(f"myturn: no hay vault en {VAULT}")
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(CACHE / "obsidian.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return {"skip": "otra pasada en curso"}
        if not NO_SYNC:
            do_sync()
        last_f = CACHE / "obsidian-last.json"
        try:
            last = json.loads(last_f.read_text())
        except (OSError, ValueError):
            last = {}
        out: dict = {"imported": [], "edits": 0, "wrote": False}
        for d in (date.today() - timedelta(days=1), date.today()):
            out["imported"] += import_daily(daily_path(d))
        if gate_quiet(TAREAS):
            out["edits"] = read_tareas(fold(), last)
            text, last = render_tareas(compute()["rows"])
            if not TAREAS.exists() or TAREAS.read_text() != text:
                write_atomic(TAREAS, text)
                out["wrote"] = True
            last_f.write_text(json.dumps(last, ensure_ascii=False))
        if (out["imported"] or out["edits"]) and not NO_SYNC:
            do_sync()
        return out


# ── barra y panel ─────────────────────────────────────────────────────────────────────────────────
C = {"white": "0xffe5e9f0", "dim": "0xff9aa3b5", "green": "0xffa3be8c"}


def trunc(s: str, n: int) -> str:
    return s if len(s) <= n else s[: n - 1].rstrip() + "…"


def bar_label(st: dict) -> tuple[str, str, str]:
    """(punto, color, texto) de la barra: te espera (verde) > trabajando > tu tarea más importante."""
    w = st["waiting"]
    if w:
        head = "te espera" if len(w) == 1 else f"{len(w)} te esperan"
        return "●", "green", f"{trunc(w[0]['title'], 38)} · {head}"
    if st["working"]:
        k = st["working"]
        return "◌", "dim", f"{trunc(k[0]['title'], 38)} · trabajando" + (f" (+{len(k) - 1})" if len(k) > 1 else "")
    if st["rows"]:
        return "○", "white", trunc(st["rows"][0]["title"], 44)
    return "○", "dim", "sin tareas · clic para anotar"


def sketchybar(st: dict) -> None:
    if shutil.which("sketchybar"):
        dot, color, label = bar_label(st)
        subprocess.run(["sketchybar", "--set", "myturn", f"icon={dot}", f"icon.color={C[color]}", f"label={label}",
                        f"label.color={C[color]}"], capture_output=True, timeout=5)


def refresh() -> dict:
    st = compute()
    if LOCAL == "mac":
        sketchybar(st)
    return st


def panel() -> dict:
    st = refresh()
    rows = [{k: r[k] for k in ("id", "title", "prio", "due", "state", "dot", "say", "can_go", "can_resume")}
            | {"prompt": claude_prompt(r)} for r in st["rows"]]
    return {"rows": rows, "background": st["background"], "herdr_ok": st["herdr_ok"]}


# ── CLI ───────────────────────────────────────────────────────────────────────────────────────────
def main(argv: list[str]) -> None:
    ap = argparse.ArgumentParser(prog="myturn", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("add")
    p.add_argument("text", nargs="+")
    p.add_argument("--raw", action="store_true")
    p.add_argument("--prio", type=int, choices=[1, 2])
    p.add_argument("--due")
    p = sub.add_parser("edit")
    p.add_argument("id")
    p.add_argument("title", nargs="+")
    p = sub.add_parser("prio")
    p.add_argument("level", type=int, choices=[0, 1, 2])
    p.add_argument("--id")
    for name in ("done", "archive", "restore", "go", "link"):
        sub.add_parser(name).add_argument("id", nargs="?" if name == "done" else None)
    sub.add_parser("ls").add_argument("--json", action="store_true")
    for name in ("jump", "import", "track", "panel", "sketchybar", "obsidian", "_sync"):
        sub.add_parser(name)
    sub.add_parser("_agents").add_argument("host")
    sub.add_parser("garden").add_argument("--ai", action="store_true")
    sub.add_parser("enrich").add_argument("id")
    a = ap.parse_args(argv)
    cmd = a.cmd or "jump"

    if cmd == "_sync":
        return do_sync()
    if cmd == "_agents":
        herdr_agents(a.host, fresh=True)
        return
    if cmd == "track":
        try:
            track(json.loads(sys.stdin.read() or "{}"))
        except Exception:  # un hook nunca debe romper el prompt
            pass
        return
    if cmd == "sketchybar":
        if every("pull", 120):
            sync_bg()
        if every("garden", 6 * 3600):
            spawn("garden")
        return sketchybar(compute(notify_new=True))
    if cmd == "enrich":
        return enrich(a.id)
    if cmd == "jump":
        return print(jump())
    if cmd == "obsidian":
        return print(json.dumps(obsidian_sync(), ensure_ascii=False))
    if cmd == "panel":
        return print(json.dumps(panel(), ensure_ascii=False))
    if cmd == "import":
        n = import_sessions()
        refresh()
        return print(f"importadas: {n}")
    if cmd == "garden":
        for act in garden(a.ai):
            print(json.dumps(act, ensure_ascii=False))
        refresh()
        return
    if cmd == "link":
        return print(link_here(a.id))
    if cmd == "go":
        return print(go(find(fold(), a.id)))
    if cmd == "ls":
        st = refresh()
        if a.json:
            return print(json.dumps(st, ensure_ascii=False, default=str))
        for r in st["rows"]:
            print(f"{r['dot']} {r['id']}  {r['title']}" + (f"  !{r['prio']}" if r["prio"] else "") + f"  — {r['say']}")
        return print(f"({st['background']} sesiones sin tarea)")

    if cmd == "add":
        text, tid = " ".join(a.text).strip(), new_id()
        emit("add", tid, title=text[:120], raw=text if a.raw else None, prio=a.prio, due=a.due, source="capture")
        if a.raw:
            spawn("enrich", tid)
        msg, t = "nueva", {"id": tid, "title": text}
    elif cmd == "edit":
        t = find(fold(), a.id)
        emit("update", t["id"], set={"title": " ".join(a.title).strip()})
        msg = "renombrada"
    elif cmd == "prio":
        t = target(a.id)
        emit("update", t["id"], set={"prio": a.level or None})
        msg = f"!{a.level}" if a.level else "sin prioridad"
    elif cmd == "done":
        t = target(a.id)
        emit("done", t["id"])
        msg = "hecha"
    else:  # archive | restore
        t = find(fold(), a.id)
        emit(cmd, t["id"], **({"reason": "a mano", "by": "user"} if cmd == "archive" else {}))
        msg = cmd
    sync_bg()
    refresh()
    print(f"{msg}: {t['id']}  {t['title']}")


if __name__ == "__main__":
    main(sys.argv[1:])
