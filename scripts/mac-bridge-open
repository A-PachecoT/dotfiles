#!/usr/bin/env bash
# Open a file from this headless box on the Mac: copy it to a cache there, then
# Quick Look it or reveal it in Finder. Used by yazi (quicklook.sh / reveal.sh)
# when the TUI runs on Arch inside the Herdr app and there is no local GUI.
# Override the Mac host with CLIP_REMOTE (same bridge as mac-clipboard).
set -euo pipefail

mode="${1:-}" file="${2:-}"
[[ -n "$mode" && -f "$file" ]] || { echo "usage: mac-bridge-open quicklook|reveal <file>" >&2; exit 2; }

REMOTE="${CLIP_REMOTE:-styreep@100.73.150.52}"
MAX_BYTES=$((500 * 1024 * 1024))
(( $(stat -c %s -- "$file") <= MAX_BYTES )) || { echo "mac-bridge-open: file over 500 MB" >&2; exit 1; }

name="$(basename -- "$file")"
# One folder per source dir, so same-named files from different repos don't collide.
sub="$(printf '%s' "$(cd -- "$(dirname -- "$file")" && pwd)" | sha1sum | cut -c1-10)"
dest="Library/Caches/arch-files/$sub/$name"
qdest="$(printf '%q' "$dest")"

ssh_mac() { ssh -F /dev/null -o ConnectTimeout=5 -o BatchMode=yes "$REMOTE" "$@"; }

ssh_mac "mkdir -p \"\$(dirname $qdest)\" && cat > $qdest" < "$file"

case "$mode" in
    quicklook)
        # qlmanage blocks until the panel closes; bring it to front like the Mac branch does.
        ssh_mac "cd ~ && (qlmanage -p $qdest >/dev/null 2>&1 &) ; sleep 0.3; osascript -e 'tell application \"System Events\" to set frontmost of process \"qlmanage\" to true' >/dev/null 2>&1 || true"
        ;;
    reveal)
        ssh_mac "cd ~ && open -R $qdest"
        ;;
    *) echo "mac-bridge-open: unknown mode $mode" >&2; exit 2 ;;
esac
