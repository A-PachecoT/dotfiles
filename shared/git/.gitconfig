[user]
    name = A-PachecoT
    email = andre.pacheco.t@uni.pe
[init]
    defaultBranch = main
[merge]
    tool = vimdiff
[diff]
	tool = vscode
[core]
    editor = vim
    fileMode = false
[push]
    autoSetupRemote = true
    default = current

[pull]
    default = current
    rebase = true

[alias]
    st = status -s
    sta = status
    conf = config --global --edit
    cge = config --global --edit
    ci = commit
    co = checkout
    cod = checkout .
    rh = reset HEAD
    aa = add -A
    cdf = clean -df
    br = branch
    bra = branch -a
    pr = pull --rebase
    amend = commit -a --amend --no-edit
    ciam = commit -a --amend --no-edit
[url "https://github.com/"]
	insteadOf = ssh://git@github.com/
	insteadOf = git@github.com:
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[credential]
	helper = osxkeychain
# OJO: `gh auth login` escribe su credential helper acá con PATH ABSOLUTO
# (`/usr/bin/gh` en Arch, `/opt/homebrew/bin/gh` en Mac) porque ~/.gitconfig es
# el symlink a este archivo. Eso es el ping-pong que CLAUDE.md prohíbe en
# shared/. El helper ya vive per-box en ~/.config/git/config (no stowed) y git
# lee los dos archivos — si volvés a ver un bloque [credential "https://..."]
# acá abajo, sacalo: es basura que escribió gh, no configuración.
